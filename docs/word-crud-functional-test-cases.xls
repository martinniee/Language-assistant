<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40" xmlns:dt="uuid:C2F41010-65B3-11d1-A29F-00AA00C14882"><DocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><LastAuthor>Martin</LastAuthor><Created>2026-06-08T01:54:30Z</Created><LastSaved>2026-06-08T03:39:43Z</LastSaved></DocumentProperties><CustomDocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><ICV dt:dt="string">25B5780E9EB84D15B429DD9F65D47DFA_12</ICV><KSOProductBuildVer dt:dt="string">2052-12.1.0.26895</KSOProductBuildVer><CalculationRule dt:dt="float">0</CalculationRule></CustomDocumentProperties><ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel"><WindowWidth>17280</WindowWidth><WindowHeight>6870</WindowHeight><ActiveSheet>1</ActiveSheet><ProtectStructure>False</ProtectStructure><ProtectWindows>False</ProtectWindows></ExcelWorkbook><Styles><Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Center"/><Borders/><Font ss:FontName="宋体" x:CharSet="134" ss:Size="11" ss:Color="#000000"/><Interior/><NumberFormat/><Protection/></Style><Style ss:ID="s49"/><Style ss:ID="s50"><Alignment ss:Vertical="Top" ss:WrapText="1"/><Font ss:FontName="Microsoft YaHei" x:CharSet="134" ss:Size="11" ss:Bold="1"/><Interior ss:Color="#E8F0FE" ss:Pattern="Solid"/></Style><Style ss:ID="s51"><Alignment ss:Vertical="Top" ss:WrapText="1"/><Font ss:FontName="Microsoft YaHei" x:CharSet="134" ss:Size="11"/></Style><Style ss:ID="s52"><Alignment ss:Horizontal="Center" ss:Vertical="Center"/></Style><Style ss:ID="s53"><Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/></Borders><Font ss:FontName="Microsoft YaHei" x:CharSet="134" ss:Size="11" ss:Bold="1"/><Interior ss:Color="#E8F0FE" ss:Pattern="Solid"/></Style><Style ss:ID="s54"><Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/></Borders><Font ss:FontName="Microsoft YaHei" x:CharSet="134" ss:Size="11"/></Style><Style ss:ID="s55"><Alignment ss:Horizontal="Center" ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/></Borders></Style><Style ss:ID="s56"><Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/></Borders><Font ss:FontName="Microsoft YaHei" x:CharSet="134" ss:Size="11"/></Style></Styles><Worksheet ss:Name="测试说明"><Table ss:ExpandedColumnCount="2" ss:ExpandedRowCount="8" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="14.1"><Column ss:Index="2" ss:StyleID="Default" ss:AutoFitWidth="0" ss:Width="350.7"/><Row ss:Height="113.4"><Cell ss:StyleID="s50"><Data ss:Type="String">文档名称</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">Language Assistant 单词 CRUD 功能测试用例</Data></Cell></Row><Row ss:Height="76.5"><Cell ss:StyleID="s51"><Data ss:Type="String">文件路径</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">docs/word-crud-functional-test-cases.xls</Data></Cell></Row><Row ss:Height="137.7"><Cell ss:StyleID="s51"><Data ss:Type="String">适用范围</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">单词管理基础增删改查、查看详情、查询筛选、Markdown 持久化一致性</Data></Cell></Row><Row ss:Height="76.5"><Cell ss:StyleID="s51"><Data ss:Type="String">测试对象</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">Obsidian 插件 Language Assistant</Data></Cell></Row><Row ss:Height="198.9"><Cell ss:StyleID="s51"><Data ss:Type="String">时间戳规则</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">新写入 createAt/lastUpdate/nextReviewDate/lastReviewDate 使用 YYYYMMDDHHmm；旧 ISO 需兼容读取</Data></Cell></Row><Row ss:Height="61.2"><Cell ss:StyleID="s51"><Data ss:Type="String">执行状态说明</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">未执行 / 通过 / 失败 / 阻塞 / 不适用</Data></Cell></Row><Row ss:Height="61.2"><Cell ss:StyleID="s51"><Data ss:Type="String">优先级说明</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">P0 核心阻断；P1 重要；P2 一般回归</Data></Cell></Row><Row ss:Height="122.4"><Cell ss:StyleID="s51"><Data ss:Type="String">维护要求</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">功能或数据格式变更后同步更新本文件与 docs/requirement.md</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>13</TopRowBottomPane><ActivePane>2</ActivePane><Panes><Pane><Number>3</Number></Pane><Pane><Number>2</Number><ActiveRow>0</ActiveRow><ActiveCol>0</ActiveCol><RangeSelection>R1C1</RangeSelection></Pane></Panes><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="CRUD功能用例"><Table ss:ExpandedColumnCount="16" ss:ExpandedRowCount="31" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="14.1"><Column ss:Index="1" ss:StyleID="Default" ss:AutoFitWidth="0" ss:Width="225.4" ss:Span="13"/><Row ss:StyleID="s52" ss:Height="16.2"><Cell ss:StyleID="s53"><Data ss:Type="String">用例编号</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">一级模块</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">功能点</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">优先级</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">前置条件</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">测试数据</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">操作步骤</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">预期结果</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">数据验证点</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">自动化建议</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">执行状态</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">实际结果</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">缺陷编号</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">备注</Data></Cell><Cell ss:StyleID="s55"/><Cell ss:StyleID="s55"/></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-ADD-001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-新增</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">打开新增单词弹窗</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">已打开 Language Assistant 单词管理页</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">无</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 点击“添加单词”。2. 观察弹窗标题、字段和底部按钮。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">弹窗正常打开；标题、字段、保存/取消按钮可见；无乱码。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">不写入 words.md；当前单词数量不变。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">UI/E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">基础入口</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-ADD-002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-新增</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">新增最小必填单词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中不存在 test-basic</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">name=test-basic</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开新增弹窗。2. 只填写单词名称。3. 点击“添加单词”。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">保存成功，列表出现 test-basic，刷新后仍可见。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 中出现 ## test-basic；生成 item-meta；id/createAt/lastUpdate 存在；lastUpdate 为 YYYYMMDDHHmm。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">核心新增</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-ADD-003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-新增</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">新增完整字段单词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中不存在 </Data></Cell><Cell ss:StyleID="s56"><ss:Data ss:Type="String" xmlns="http://www.w3.org/TR/REC-html40">name=elaborate；发音=/<Font html:Face="宋体">ɪ</Font><Font html:Face="Times New Roman">ˈ</Font>læb<Font html:Face="Arial">ə</Font>r<Font html:Face="Arial">ə</Font>t/；分类=学术；标签=写作,高频；等级=中级；词性=形容词；定义=复杂详尽的；例句=The plan is elaborate.</ss:Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 填写所有基础字段。2. 添加词性、定义、例句。3. 保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">列表和详情页完整显示新增内容；标签/分类/等级可见；无乱码。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 内容区包含发音、分类、标签、等级、词性、定义、例句；item-meta 与 srs-meta 格式正确。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">覆盖主要字段</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-ADD-004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-新增</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">重复单词拦截</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中已存在 hello</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">name=hello</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开新增弹窗。2. 输入已存在单词名。3. 点击保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">显示重复提示；不新增第二条 hello。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 中 hello 只出现一次；列表数量不增加。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">数据安全</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-ADD-005</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-新增</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">空名称校验</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">已打开新增弹窗</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">name=空字符串或空格</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 不填写名称或只输入空格。2. 点击保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">显示名称不能为空提示；弹窗保持可编辑。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 不发生变化；不生成空标题。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">输入校验</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-ADD-006</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-新增</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">取消新增不保存</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">已打开新增弹窗</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">name=temp-cancel</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 填写若干字段。2. 点击取消或关闭。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">弹窗关闭；列表中不出现 temp-cancel。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 不包含 temp-cancel。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">取消流程</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-QUERY-001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-查询</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">按单词名称搜索</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在 aggression、aggressive</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">搜索词=aggress</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 输入搜索词。2. 观察列表/网格结果。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">匹配单词显示；无关单词被过滤；搜索框文字无乱码。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 不被修改，除非进入详情触发查询次数逻辑。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">核心查询</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-QUERY-002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-查询</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">按分类筛选</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在分类=生词/熟词的数据</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">分类=生词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开筛选面板。2. 选择分类“生词”。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">仅展示该分类单词；筛选状态清晰。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">筛选不改变 words.md。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">筛选</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-QUERY-003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-查询</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">按标签筛选</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在标签=外刊词汇</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">标签=外刊词汇</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开筛选面板。2. 选择标签。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">仅展示含该标签的单词；可清除筛选。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">筛选不改变 words.md。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">筛选</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-QUERY-004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-查询</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">组合筛选</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中有不同等级与词性</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">等级=中级；词性=名词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 同时选择等级和词性。2. 查看结果。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">结果满足所有筛选条件；无布局遮挡。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">筛选不改变 words.md。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">组合筛选</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-QUERY-005</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-查询</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">清除筛选条件</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">当前存在搜索词或筛选条件</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">无</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 点击清除筛选。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">搜索/筛选状态恢复默认；列表显示全部可分页数据。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">不改变 words.md。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">状态恢复</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-QUERY-006</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-查看</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">查看单词详情</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">列表中存在单词 abstruse</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">word=abstruse</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 点击单词卡片/行。2. 进入详情页。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">详情页显示名称、发音、分类、标签、等级、词性、定义、例句；文案无乱码。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">若搜索框有内容，viewCount 增加；若无搜索词，viewCount 不变。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">详情页</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-QUERY-007</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-查看</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">跳转到 Markdown 源文件</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词存在于 words.md</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">word=abstruse</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 点击跳转源文件按钮。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Obsidian 打开 words.md 并定位到对应单词附近。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">不改变单词数据；打开的文件路径符合设置。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">手工/E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">Obsidian 集成</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">编辑单词名称</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在 test-basic，且不存在 test-basic-renamed</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">原名称=test-basic；新名称=test-basic-renamed</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开编辑弹窗。2. 修改名称。3. 保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">列表中出现新名称；旧名称不再作为独立单词出现。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 标题更新；id/createAt 保持不变；lastUpdate 刷新为当前 YYYYMMDDHHmm。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">核心编辑</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">编辑基础字段</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在 elaborate</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">修改发音、分类、等级、标签、备注</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开编辑弹窗。2. 修改基础字段。3. 保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">详情页展示新字段；筛选可按新分类/标签命中。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">item-meta 中分类/标签/等级更新；lastUpdate 刷新；createAt 不变。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">基础字段</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">编辑词性定义例句</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在完整内容单词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">新增/删除/修改词性、定义、例句</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开编辑。2. 修改层级内容。3. 保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">详情页层级内容与编辑结果一致。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 内容区结构正确；lastUpdate 刷新。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">复杂内容</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">编辑为重复名称拦截</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在 hello 和 world</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">将 world 改名为 hello</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 编辑 world。2. 名称改为 hello。3. 保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">显示重复提示；world 保持原名称；hello 不重复。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 不产生重复 ## hello；world 原数据保留。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">数据安全</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-005</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">编辑为空名称校验</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在任意单词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">name=空字符串</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开编辑。2. 清空名称。3. 保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">显示错误提示；不保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 不变化；lastUpdate 不应刷新。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">输入校验</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-006</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">取消编辑不保存</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在 elaborate</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">修改但点击取消</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开编辑。2. 修改字段。3. 点击取消。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">弹窗关闭，列表/详情仍显示原数据。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 不变化；lastUpdate 不刷新。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">取消流程</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-007</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">更新时间同步</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">记录编辑前 lastUpdate</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">修改 notes=更新时间验证</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 打开编辑。2. 修改备注。3. 保存。4. 重新读取详情或 words.md。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">lastUpdate 变为保存时刻，格式为 YYYYMMDDHHmm。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">id/createAt 不变；lastUpdate 大于或不同于编辑前值；静默 viewCount 更新不改变 lastUpdate。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">针对已修复问题</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-EDIT-008</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">SRS 元数据保持兼容</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词已复习过，存在 srsMeta</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">修改基础释义字段</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 编辑单词内容。2. 保存。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">内容更新成功；复习等级、间隔、次数不因普通编辑被重置。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">srsLevel/reviewCount/ease/interval 保持原值；lastUpdate 刷新。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">API/E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">兼容性</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-DELETE-001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-删除</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">删除取消</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在 delete-cancel</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">word=delete-cancel</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 点击删除。2. 在确认框点击取消。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词仍存在；不显示成功删除提示。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 仍包含该单词；数量不变。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">防误删</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-DELETE-002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-删除</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">确认删除单词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在 delete-ok</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">word=delete-ok</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 点击删除。2. 确认删除。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">列表中移除该单词；显示成功提示。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 不再包含 ## delete-ok；其他单词不受影响。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E/API</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">核心删除</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-DELETE-003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-删除</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">详情页删除后返回列表</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">当前查看 delete-detail 详情</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">word=delete-detail</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 在详情页删除。2. 确认。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">删除成功后退出详情或返回列表，不停留在空详情。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 已移除该单词；UI 不报错。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">未执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">导航一致性</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-DELETE-004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-删除</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">删除后搜索结果刷新</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">搜索结果中包含 delete-search</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">word=delete-search</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 搜索 delete-search。2. 删除该单词。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">结果列表立即刷新；空状态正确展示。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 已移除；分页计数更新。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">刷新一致性</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-DELETE-005</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">单词管理-删除</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">删除不会破坏全局元数据</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P2</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">词库中存在全局标签/分类配置</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">删除一个使用标签的单词</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 删除单词。2. 查看其他单词和元数据页。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">其他单词标签分类仍可解析；元数据页可打开。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">%%global-meta 保持合法 JSON；未误删其他词条。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">API/E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">元数据兼容</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-REG-001</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">基础回归</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">加载旧格式词库</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">准备含旧 metadata 的 words.md</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">旧 ISO lastUpdate/nextReviewDate</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 加载插件。2. 打开单词管理。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">旧数据正常显示；时间可解析；保存后时间规范化。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">旧 ISO 不导致 Invalid Date；保存后使用 YYYYMMDDHHmm。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">API/E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">未执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">兼容读取</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-REG-002</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">基础回归</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">新增编辑删除连续操作</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">空白或测试词库</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">add-chain/edit-chain/delete-chain</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 新增单词。2. 编辑名称和释义。3. 删除单词。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">每一步 UI 与文件同步，无重复、无残留。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">words.md 最终不包含删除词；中间每次保存 JSON 元数据合法。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">未执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">端到端</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-REG-003</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">基础回归</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">刷新后数据保持</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P0</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">完成一次新增或编辑</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">无</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 执行新增/编辑。2. 关闭并重新打开单词管理视图。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">数据仍存在且字段正确。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">重新解析 words.md 后结果一致。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">持久化</Data></Cell></Row><Row ss:Height="61"><Cell ss:StyleID="s56"><Data ss:Type="String">TC-WORD-REG-004</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">基础回归</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">错误提示无乱码</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">P1</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">触发空名称、重复名称、删除取消等场景</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">无</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">1. 分别触发错误或确认提示。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">用户可见提示为正常中文或明确英文，无乱码。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">不改变有效数据。</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">手工/E2E</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">执行</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">通过</Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="s56"><Data ss:Type="String">文案质量</Data></Cell></Row></Table><WorksheetOptions 